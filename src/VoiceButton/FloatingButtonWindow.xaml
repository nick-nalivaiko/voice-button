<Window x:Class="VoiceButton.FloatingButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Button Floating"
        Width="100"
        Height="50"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">
    <Grid>
        <Border x:Name="ButtonShell"
                Margin="0,8,8,0"
                CornerRadius="21"
                BorderBrush="#2B8DFF"
                BorderThickness="1.2"
                Cursor="Hand"
                ToolTip="Микрофон / новый ответ; ПКМ по динамику: озвучить clipboard"
                AutomationProperties.Name="Voice Button: микрофон слева, новый ответ справа; ПКМ по динамику озвучивает clipboard"
                MouseLeftButtonDown="ButtonShell_MouseLeftButtonDown"
                MouseLeftButtonUp="ButtonShell_MouseLeftButtonUp"
                MouseMove="ButtonShell_MouseMove">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1B31" Offset="0" />
                <GradientStop Color="#06101D" Offset="0.48" />
                <GradientStop Color="#010711" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid x:Name="ContentClip" ClipToBounds="True" SizeChanged="ContentClip_SizeChanged">
            <Grid x:Name="CompactGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition x:Name="CompactResumeColumn" Width="0" />
                    <ColumnDefinition x:Name="CompactResumeDividerColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="18,0,0,18">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.38,0.22" Center="0.46,0.42" RadiusX="0.78" RadiusY="0.86">
                            <GradientStop Color="#0D2038" Offset="0" />
                            <GradientStop Color="#06101D" Offset="0.62" />
                            <GradientStop Color="#010711" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Ellipse Margin="7" Stroke="#1E96FF" StrokeThickness="1" Opacity="0.26" />
                        <Path x:Name="CompactMicrophoneGlyph" Fill="#37D0F4"
                              Data="M 12 4 C 9.8 4 8 5.8 8 8 L 8 16 C 8 18.2 9.8 20 12 20 C 14.2 20 16 18.2 16 16 L 16 8 C 16 5.8 14.2 4 12 4 Z M 5 14 C 5 18 8 21 12 21 C 16 21 19 18 19 14 L 17 14 C 17 16.9 14.9 19 12 19 C 9.1 19 7 16.9 7 14 Z M 11 21 L 13 21 L 13 25 L 17 25 L 17 27 L 7 27 L 7 25 L 11 25 Z"
                              Width="22"
                              Height="24"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                        <Grid x:Name="CompactRecordingGlyph" Visibility="Collapsed">
                            <Ellipse Margin="7" Fill="#123B72" Stroke="#37D0F4" StrokeThickness="1.2" />
                            <Border Width="11"
                                    Height="11"
                                    CornerRadius="2.5"
                                    Background="#37D0F4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Width="1" Background="#2B8DFF" Opacity="0.48" />

                <Border x:Name="CompactResumeZone" Grid.Column="2" Background="#071528" Visibility="Collapsed">
                    <StackPanel x:Name="CompactResumeContent"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="3" Height="9" CornerRadius="2" Background="#2B8DFF" Margin="1.2,0" />
                        <Border Width="3" Height="17" CornerRadius="2" Background="#24A3FF" Margin="1.2,0" />
                        <Border Width="3" Height="25" CornerRadius="2" Background="#37D0F4" Margin="1.2,0" />
                        <Border Width="3" Height="30" CornerRadius="2" Background="#2B8DFF" Margin="1.2,0" />
                        <Border Width="3" Height="21" CornerRadius="2" Background="#37D0F4" Margin="1.2,0" />
                        <Border Width="3" Height="13" CornerRadius="2" Background="#24A3FF" Margin="1.2,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="CompactResumeDivider" Grid.Column="3" Width="1" Background="#2B8DFF" Opacity="0.48" Visibility="Collapsed" />

                <Border Grid.Column="4"
                        CornerRadius="0,18,18,0"
                        MouseRightButtonDown="CompactSpeakerZone_MouseRightButtonDown">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.42,0.25" Center="0.46,0.48" RadiusX="0.86" RadiusY="0.9">
                            <GradientStop Color="#123B72" Offset="0" />
                            <GradientStop Color="#0D2038" Offset="0.58" />
                            <GradientStop Color="#010711" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Grid x:Name="CompactSpeakerContent"
                          Width="25"
                          Height="25"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Path Fill="#37D0F4"
                              Data="M 3 9 L 8 9 L 13 5 L 13 19 L 8 15 L 3 15 Z"
                              Stretch="Uniform"
                              Width="13"
                              Height="16"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center" />
                        <Path Stroke="#24A3FF"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 15.5 8.5 C 18.5 10.5 18.5 13.5 15.5 15.5"
                              Stretch="Uniform"
                              Width="5"
                              Height="9"
                              Margin="13,0,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center" />
                        <Path Stroke="#2B8DFF"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 18 5.5 C 23 9 23 15 18 18.5"
                              Stretch="Uniform"
                              Width="7"
                              Height="14"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="PlayerGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="43" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="186" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="43" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="18,0,0,18" Background="#0A1B30">
                    <Grid>
                        <Ellipse Margin="6" Fill="#0B3764" Stroke="#1E96FF" StrokeThickness="1" Opacity="0.9" />
                        <Grid x:Name="PauseGlyph" Width="14" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="4" Height="15" CornerRadius="1.5" Background="#37D0F4" HorizontalAlignment="Left" />
                            <Border Width="4" Height="15" CornerRadius="1.5" Background="#37D0F4" HorizontalAlignment="Right" />
                        </Grid>
                        <Path x:Name="PlayGlyph"
                              Visibility="Collapsed"
                              Fill="#37D0F4"
                              Data="M 5 3 L 18 11 L 5 19 Z"
                              Width="15"
                              Height="17"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Width="1" Background="#2B8DFF" Opacity="0.42" />

                <Border Grid.Column="2" Background="#071528">
                    <Grid Margin="8,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="141" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="135" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Width="135" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.22">
                                <Border Width="3" Height="8" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="13" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="20" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="11" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="25" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="17" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="9" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="22" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="27" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="15" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="23" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="10" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="18" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="12" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="7" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="14" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="21" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="11" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="24" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="16" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="8" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="19" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="26" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="13" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="18" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="9" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                <Border Width="3" Height="22" CornerRadius="2" Background="#37D0F4" Margin="1" />
                            </StackPanel>

                            <Grid x:Name="PlayedWaveformClip"
                                  Width="0"
                                  Height="28"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  ClipToBounds="True">
                                <StackPanel Orientation="Horizontal" Width="135" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Width="3" Height="8" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="13" CornerRadius="2" Background="#24A3FF" Margin="1" />
                                    <Border Width="3" Height="20" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                    <Border Width="3" Height="11" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="25" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                    <Border Width="3" Height="17" CornerRadius="2" Background="#24A3FF" Margin="1" />
                                    <Border Width="3" Height="9" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="22" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                    <Border Width="3" Height="27" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="15" CornerRadius="2" Background="#24A3FF" Margin="1" />
                                    <Border Width="3" Height="23" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                    <Border Width="3" Height="10" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="18" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                    <Border Width="3" Height="12" CornerRadius="2" Background="#24A3FF" Margin="1" />
                                    <Border Width="3" Height="7" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="14" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                    <Border Width="3" Height="21" CornerRadius="2" Background="#24A3FF" Margin="1" />
                                    <Border Width="3" Height="11" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="24" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                    <Border Width="3" Height="16" CornerRadius="2" Background="#24A3FF" Margin="1" />
                                    <Border Width="3" Height="8" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="19" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                    <Border Width="3" Height="26" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="13" CornerRadius="2" Background="#24A3FF" Margin="1" />
                                    <Border Width="3" Height="18" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                    <Border Width="3" Height="9" CornerRadius="2" Background="#2B8DFF" Margin="1" />
                                    <Border Width="3" Height="22" CornerRadius="2" Background="#37D0F4" Margin="1" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="PlaybackTimeText"
                                   Grid.Column="1"
                                   Text="0:00"
                                   FontSize="11"
                                   Foreground="#8BA4C2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Column="3" Width="1" Background="#2B8DFF" Opacity="0.42" />

                <Border Grid.Column="4" CornerRadius="0,18,18,0" Background="#0A1B30">
                    <Grid Width="31" Height="31" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Fill="#0B3764" Stroke="#1E96FF" StrokeThickness="1.2" Opacity="0.9" />
                        <Border Width="11"
                                Height="11"
                                CornerRadius="2.5"
                                Background="#37D0F4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            </Grid>
        </Border>

        <Border x:Name="LiveNarrationButton"
                Panel.ZIndex="20"
                Width="22"
                Height="22"
                CornerRadius="11,11,8,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#2A1F0E"
                BorderBrush="#F0A62E"
                BorderThickness="1.3"
                Visibility="Collapsed"
                Cursor="Hand"
                ToolTip="Озвучивать ход работы Codex"
                MouseLeftButtonDown="LiveNarrationButton_MouseLeftButtonDown">
            <Grid>
                <Rectangle x:Name="LiveNarrationGlow"
                           Margin="2"
                           RadiusX="6.5"
                           RadiusY="6.5"
                           Fill="#C97A16"
                           Opacity="0.35" />
                <Rectangle x:Name="LiveNarrationDot"
                           Width="6"
                           Height="6"
                           RadiusX="2"
                           RadiusY="2"
                           Fill="#FFD166"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
