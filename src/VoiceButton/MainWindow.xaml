                            <TextBlock x:Name="RecognitionSectionTitleText" Style="{StaticResource SectionTitle}" Text="Распознавание" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE753;" />
                                <TextBlock x:Name="TranscriptionProviderLabelText" Grid.Column="1" Style="{StaticResource FieldLabel}" Text="Поставщик" />
                                <Border Grid.Column="2" Style="{StaticResource FieldShell}"><TextBlock Text="OpenAI" Foreground="{StaticResource TextPrimary}" FontSize="16" VerticalAlignment="Center" /></Border>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8B8;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TranscriptionModelLabelText" Style="{StaticResource FieldLabel}" Text="Модель распознавания" />
                                    <TextBlock x:Name="TranscriptionModelHintText" Style="{StaticResource FieldHint}" Text="Основная модель точнее, mini дешевле." />
                                </StackPanel>
                                <ComboBox x:Name="TranscriptionModelComboBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="TranscriptionModelComboBox_SelectionChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE774;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TranscriptionLanguageLabelText" Style="{StaticResource FieldLabel}" Text="Язык речи" />
                                    <TextBlock x:Name="TranscriptionLanguageHintText" Style="{StaticResource FieldHint}" Text="Авто подходит, если языки меняются." />
                                </StackPanel>
                                <ComboBox x:Name="TranscriptionLanguageComboBox" Grid.Column="2" Style="{StaticResource DarkComboBox}" SelectionChanged="TranscriptionLanguageComboBox_SelectionChanged" />
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8D7;" />
                                <TextBlock x:Name="DictationKeyLabelText" Grid.Column="1" Style="{StaticResource FieldLabel}" Text="OpenAI API key" />
                                <Border Grid.Column="2" Style="{StaticResource FieldShell}">
                                    <TextBlock x:Name="DictationKeyHintText" Text="Используется ключ из раздела «Озвучка»." Foreground="#9FB0C5" FontSize="14" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="DictationBehaviorSectionTitleText" Style="{StaticResource SectionTitle}" Text="Поведение" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8D2;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="InsertDictationLabelText" Style="{StaticResource FieldLabel}" Text="Вставлять текст автоматически" />
                                    <TextBlock x:Name="InsertDictationHintText" Style="{StaticResource FieldHint}" Text="Если курсор стоит в поле ввода, текст вставится туда; иначе останется в clipboard." />
                                </StackPanel>
                                <ToggleButton x:Name="InsertDictationToggle" Grid.Column="2" Style="{StaticResource NeonToggle}" Checked="DictationToggle_Changed" Unchecked="DictationToggle_Changed" />
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8D5;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="RestoreDictationClipboardLabelText" Style="{StaticResource FieldLabel}" Text="Восстанавливать clipboard после вставки" />
                                    <TextBlock x:Name="RestoreDictationClipboardHintText" Style="{StaticResource FieldHint}" Text="После успешной вставки возвращает прежнее содержимое буфера обмена." />
                                </StackPanel>
                                <ToggleButton x:Name="RestoreDictationClipboardToggle" Grid.Column="2" Style="{StaticResource NeonToggle}" Checked="DictationToggle_Changed" Unchecked="DictationToggle_Changed" />
                            </Grid>

                            <Border Style="{StaticResource InfoCard}">
                                <StackPanel>
                                    <TextBlock x:Name="DictationRoutingTitleText" Text="Как работает кнопка микрофона" Foreground="{StaticResource TextPrimary}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DictationRoutingHintText" Text="В Codex и ChatGPT запускается встроенный микрофон. В Telegram, Блокноте, браузере и других приложениях Voice Button записывает речь и вставляет готовый текст." Foreground="#9FB0C5" FontSize="13.5" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="HotkeysPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="HotkeysPageTitleText" Style="{StaticResource PageTitle}" Text="Горячие клавиши" />
                            <TextBlock x:Name="HotkeysPageHintText" Style="{StaticResource PageHint}" Text="Нажмите на сочетание, затем зажмите нужные клавиши. Esc отменяет запись, Delete очищает." Margin="0,6,0,24" />
                            <TextBlock x:Name="HotkeysSectionTitleText" Style="{StaticResource SectionTitle}" Text="Активные сочетания" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /><ColumnDefinition Width="124" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE765;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="SpeakHotkeyLabelText" Style="{StaticResource FieldLabel}" Text="Озвучить последний ответ" />
                                    <TextBlock x:Name="SpeakHotkeyHintText" Style="{StaticResource FieldHint}" Text="Копирует последний ответ активного Codex или ChatGPT и запускает озвучку." />
                                </StackPanel>
                                <Button x:Name="SpeakLatestHotkeyButton" Grid.Column="2" Tag="SpeakLatest" Style="{StaticResource SecondaryButton}" Content="Ctrl + Alt + V" Click="HotkeyButton_Click" />
                                <Button x:Name="ClearSpeakLatestHotkeyButton" Grid.Column="3" Tag="SpeakLatest" Style="{StaticResource SecondaryButton}" Content="Сброс" Margin="12,0,0,0" Click="ClearHotkeyButton_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /><ColumnDefinition Width="124" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE720;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClipboardHotkeyLabelText" Style="{StaticResource FieldLabel}" Text="Озвучить clipboard" />
                                    <TextBlock x:Name="ClipboardHotkeyHintText" Style="{StaticResource FieldHint}" Text="Озвучивает текущий текст из буфера обмена." />
                                </StackPanel>
                                <Button x:Name="ClipboardHotkeyButton" Grid.Column="2" Tag="Clipboard" Style="{StaticResource SecondaryButton}" Content="Не назначено" Click="HotkeyButton_Click" />
                                <Button x:Name="ClearClipboardHotkeyButton" Grid.Column="3" Tag="Clipboard" Style="{StaticResource SecondaryButton}" Content="Очистить" Margin="12,0,0,0" Click="ClearHotkeyButton_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /><ColumnDefinition Width="124" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE720;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CodexMicHotkeyLabelText" Style="{StaticResource FieldLabel}" Text="Микрофон приложения" />
                                    <TextBlock x:Name="CodexMicHotkeyHintText" Style="{StaticResource FieldHint}" Text="Нажимает встроенную кнопку микрофона в активном Codex или ChatGPT." />
                                </StackPanel>
                                <Button x:Name="CodexMicHotkeyButton" Grid.Column="2" Tag="CodexMic" Style="{StaticResource SecondaryButton}" Content="Не назначено" Click="HotkeyButton_Click" />
                                <Button x:Name="ClearCodexMicHotkeyButton" Grid.Column="3" Tag="CodexMic" Style="{StaticResource SecondaryButton}" Content="Очистить" Margin="12,0,0,0" Click="ClearHotkeyButton_Click" />
                            </Grid>

                            <Border Style="{StaticResource InfoCard}" MaxWidth="720" HorizontalAlignment="Left">
                                <StackPanel><TextBlock x:Name="HotkeyEditorTitleText" Text="Как записать сочетание" Foreground="{StaticResource TextPrimary}" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="HotkeyEditorHintText" Text="Нажмите поле сочетания, затем зажмите, например, Ctrl + Alt + V. Для глобального хоткея нужна хотя бы одна служебная клавиша." Foreground="#9FB0C5" FontSize="13.5" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" /></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="IntegrationPage" Visibility="Collapsed">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                            <TextBlock x:Name="IntegrationPageTitleText" Style="{StaticResource PageTitle}" Text="Интеграция" />
                            <TextBlock x:Name="IntegrationPageHintText" Style="{StaticResource PageHint}" Text="Автовыбор активного Codex или ChatGPT, Copy/clipboard и запуск микрофона." Margin="0,6,0,24" />

                            <TextBlock x:Name="CodexWindowSectionTitleText" Style="{StaticResource SectionTitle}" Text="Приложения" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition Width="128" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8A5;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CodexWindowKeywordsLabelText" Style="{StaticResource FieldLabel}" Text="Ключевые слова Codex" />
                                    <TextBlock x:Name="CodexWindowKeywordsHintText" Style="{StaticResource FieldHint}" Text="ChatGPT определяется автоматически; здесь можно уточнить заголовок или процесс Codex." />
                                </StackPanel>
                                <TextBox x:Name="CodexWindowKeywordsBox" Grid.Column="2" Style="{StaticResource DarkTextBox}" Margin="0,0,12,0" LostFocus="CodexWindowKeywordsBox_LostFocus" KeyDown="CodexWindowKeywordsBox_KeyDown" />
                                <Button x:Name="TestCodexWindowButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Проверить" Click="TestCodexWindowButton_Click" />
                            </Grid>

                            <TextBlock x:Name="CopyIntegrationSectionTitleText" Style="{StaticResource SectionTitle}" Text="Copy и clipboard" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8B8;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="HoverCopyButtonLabelText" Style="{StaticResource FieldLabel}" Text="Показывать Copy наведением" />
                                    <TextBlock x:Name="HoverCopyButtonHintText" Style="{StaticResource FieldHint}" Text="Если кнопка скрыта до hover, Voice Button наведет курсор в область последнего ответа." />
                                </StackPanel>
                                <ToggleButton x:Name="HoverCopyButtonToggle" Grid.Column="2" Style="{StaticResource NeonToggle}" Checked="IntegrationToggle_Changed" Unchecked="IntegrationToggle_Changed" />
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8D2;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="RestoreClipboardLabelText" Style="{StaticResource FieldLabel}" Text="Восстанавливать clipboard" />
                                    <TextBlock x:Name="RestoreClipboardHintText" Style="{StaticResource FieldHint}" Text="После Copy возвращает прежний буфер обмена, если это возможно." />
                                </StackPanel>
                                <ToggleButton x:Name="RestoreClipboardToggle" Grid.Column="2" Style="{StaticResource NeonToggle}" Checked="IntegrationToggle_Changed" Unchecked="IntegrationToggle_Changed" />
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE8D5;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ClipboardFallbackLabelText" Style="{StaticResource FieldLabel}" Text="Озвучивать clipboard без Copy" />
                                    <TextBlock x:Name="ClipboardFallbackHintText" Style="{StaticResource FieldHint}" Text="Если Copy не найден, можно озвучить уже скопированный вручную текст." />
                                </StackPanel>
                                <ToggleButton x:Name="ClipboardFallbackToggle" Grid.Column="2" Style="{StaticResource NeonToggle}" Checked="IntegrationToggle_Changed" Unchecked="IntegrationToggle_Changed" />
                            </Grid>

                            <TextBlock x:Name="MicrophoneIntegrationSectionTitleText" Style="{StaticResource SectionTitle}" Text="Микрофон приложения" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE720;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="RetryMicrophoneLabelText" Style="{StaticResource FieldLabel}" Text="Повторять запуск микрофона" />
                                    <TextBlock x:Name="RetryMicrophoneHintText" Style="{StaticResource FieldHint}" Text="Повторный клик применяется только к Codex; диктовка ChatGPT запускается один раз." />
                                </StackPanel>
                                <ToggleButton x:Name="RetryMicrophoneToggle" Grid.Column="2" Style="{StaticResource NeonToggle}" Checked="IntegrationToggle_Changed" Unchecked="IntegrationToggle_Changed" />
                            </Grid>

                            <TextBlock x:Name="DiagnosticsSectionTitleText" Style="{StaticResource SectionTitle}" Text="Диагностика" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource RowIcon}" Text="&#xE9D9;" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="DiagnosticsLabelText" Style="{StaticResource FieldLabel}" Text="Проверить активное приложение" />
                                    <TextBlock x:Name="DiagnosticsHintText" Style="{StaticResource FieldHint}" Text="Проверяет окно, Copy и микрофон. Результат пишется в diagnostics.log." />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button x:Name="TestCopyButton" Style="{StaticResource SecondaryButton}" Content="Найти Copy" Click="TestCopyButton_Click" />
                                    <Button x:Name="TestMicrophoneButton" Style="{StaticResource SecondaryButton}" Content="Найти микрофон" Margin="12,0,0,0" Click="TestMicrophoneButton_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#1B2B40" BorderThickness="0,1,0,0">
                <Grid Margin="34,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Content="Стоп" Click="StopButton_Click" />
                        <Button x:Name="ClipboardButton" Style="{StaticResource SecondaryButton}" Content="Озвучить clipboard" Margin="12,0,0,0" Click="ClipboardButton_Click" />
                        <Button x:Name="SpeakButton" Style="{StaticResource PrimaryButton}" Content="Озвучить последний ответ" Margin="12,0,0,0" Click="SpeakButton_Click" />
                    </StackPanel>
                    <Button x:Name="TrayMinimizeButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Свернуть в трей" Click="MinimizeToTrayButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
